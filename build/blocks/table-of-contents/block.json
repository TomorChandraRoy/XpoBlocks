{
  "apiVersion": 3,
  "name": "guten-builder-blocks/table-of-contents",
  "version": "1.0.0",
  "title": "Table of Contents",
  "description": "Dynamic Table of Contents block to automatically generate a list of headings.",
  "category": "guten-builder",
  "keywords": [
    "toc",
    "table of contents",
    "index",
    "outline"
  ],
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "allowedHeaders": {
      "type": "array",
      "default": [
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ]
    },
    "titleText": {
      "type": "string",
      "default": "Table of Contents"
    },
    "headerBgColor": {
      "type": "string",
      "default": "transparent"
    },
    "headerTextColor": {
      "type": "string",
      "default": "#1e293b"
    },
    "activeHeaderBgColor": {
      "type": "string",
      "default": "#f8fafc"
    },
    "activeHeaderTextColor": {
      "type": "string",
      "default": "#0f172a"
    },
    "contentBgColor": {
      "type": "string",
      "default": "transparent"
    },
    "contentTextColor": {
      "type": "string",
      "default": "#475569"
    },
    "borderColor": {
      "type": "string",
      "default": "#e2e8f0"
    },
    "activeBorderColor": {
      "type": "string",
      "default": "#cbd5e1"
    },
    "iconColor": {
      "type": "string",
      "default": "#64748b"
    },
    "activeIconColor": {
      "type": "string",
      "default": "#0f172a"
    },
    "borderRadius": {
      "type": "number",
      "default": 8
    },
    "borderWidth": {
      "type": "number",
      "default": 0
    },
    "gap": {
      "type": "number",
      "default": 12
    },
    "titleFontSize": {
      "type": "number",
      "default": 16
    },
    "contentFontSize": {
      "type": "number",
      "default": 14
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "left",
      "right",
      "wide",
      "full"
    ]
  },
  "textdomain": "guten-builder-blocks",
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style-view.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}