{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "xpo-blocks/table-of-contents",
  "version": "1.0.0",
  "title": "Table of Contents",
  "description": "Dynamic Table of Contents block to automatically generate a list of headings.",
  "category": "xpo-blocks",
  "keywords": [
    "toc",
    "table of contents",
    "index",
    "outline"
  ],
  "textdomain": "xpo-blocks",
  "attributes": {
    "align": {
      "type": "string",
      "default": "wide"
    },
    "selectedTemplate": {
      "type": "string",
      "default": ""
    },
    "allowedHeaders": {
      "type": "array",
      "default": [
        "h2",
        "h3",
        "h4"
      ]
    },
    "titleText": {
      "type": "string",
      "default": ""
    },
    "contentTitle": {
      "type": "string",
      "default": ""
    },
    "contentSubtitle": {
      "type": "string",
      "default": ""
    },
    "items": {
      "type": "array",
      "default": []
    },
    "containerWidth": {
      "type": "string",
      "default": "1140px"
    },
    "itemsGap": {
      "type": "string",
      "default": ""
    },
    "sidebarWidth": {
      "type": "string",
      "default": "320px"
    },
    "contentHeight": {
      "type": "string",
      "default": "85vh"
    },
    "sidebarBorder": {
      "type": "object"
    },
    "sidebarBorderRadius": {
      "type": "string"
    },
    "headerBgColor": {
      "type": "string",
      "default": ""
    },
    "headerTextColor": {
      "type": "string",
      "default": ""
    },
    "iconColor": {
      "type": "string",
      "default": "#64748b"
    },
    "sideHeaderTypography": {
      "type": "object",
      "default": {}
    },
    "headerIconSize": {
      "type": "string",
      "default": ""
    },
    "headerBorderWidth": {
      "type": "object"
    },
    "sidebarBgColor": {
      "type": "string",
      "default": ""
    },
    "sidebarItemColor": {
      "type": "string",
      "default": ""
    },
    "sidebarItemTypography": {
      "type": "object",
      "default": {}
    },
    "activeHeaderBgColor": {
      "type": "string",
      "default": ""
    },
    "activeTextColor": {
      "type": "string",
      "default": ""
    },
    "activeBorderLine": {
      "type": "object",
      "default": ""
    },
    "activeIconColor": {
      "type": "string",
      "default": ""
    },
    "activeBorderRadius": {
      "type": "string"
    },
    "sideTextIconSize": {
      "type": "string",
      "default": ""
    },
    "contentBgColor": {
      "type": "string",
      "default": ""
    },
    "contentBorderRadius": {
      "type": "string",
      "default": ""
    },
    "contentBorder": {
      "type": "object",
      "default": ""
    },
    "contentHeaderTextColor": {
      "type": "string",
      "default": ""
    },
    "contentHeaderTypography": {
      "type": "object",
      "default": {}
    },
    "contentHeaderBorderLine": {
      "type": "object",
      "default": ""
    },
    "contentDescriptionColor": {
      "type": "string",
      "default": ""
    },
    "contentDescriptionTypography": {
      "type": "object",
      "default": {}
    },
    "contentTitleColor": {
      "type": "string",
      "default": ""
    },
    "contentTitleTypography": {
      "type": "object",
      "default": {}
    },
    "contentParagraphColor": {
      "type": "string",
      "default": ""
    },
    "contentParagraphTypography": {
      "type": "object",
      "default": {}
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style-view.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}