{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "guten-builder-blocks/video-modal",
  "version": "1.0.0",
  "title": "Video Modal",
  "category": "guten-builder",
  "description": "Enterprise-ready video container with graceful lazy loading, inline playback, and strict URL safelists.",
  "keywords": [
    "video",
    "modal",
    "youtube",
    "vimeo",
    "player"
  ],
  "textdomain": "guten-builder-blocks",
  "attributes": {
    "selectedTemplate": {
      "type": "string",
      "default": ""
    },
    "videoUrl": {
      "type": "string",
      "default": ""
    },
    "coverImage": {
      "type": "object",
      "default": null
    },
    "autoExtractCover": {
      "type": "boolean",
      "default": true
    },
    "playbackMode": {
      "type": "string",
      "default": "modal"
    },
    "preloadLocalVideo": {
      "type": "string",
      "default": "metadata"
    },
    "buttonStyle": {
      "type": "string",
      "default": "solid"
    },
    "buttonColor": {
      "type": "string",
      "default": "#10b981"
    },
    "iconColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "buttonSize": {
      "type": "number",
      "default": 80
    },
    "dialogAriaLabel": {
      "type": "string",
      "default": "Video Player"
    },
    "playButtonAriaLabel": {
      "type": "string",
      "default": "Play Video"
    },
    "closeButtonAriaLabel": {
      "type": "string",
      "default": "Close Video"
    },
    "backdropStyle": {
      "type": "string",
      "default": "glass-dark"
    },
    "aspectRatio": {
      "type": "string",
      "default": "16x9"
    },
    "closeOnBackdrop": {
      "type": "boolean",
      "default": true
    },
    "showCloseButtonOutside": {
      "type": "boolean",
      "default": false
    },
    "imageOverlayOpacity": {
      "type": "number",
      "default": 0.3
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style-view.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}