{
  "apiVersion": 3,
  "name": "xpo-blocks/audio-player",
  "version": "1.0.0",
  "title": "Audio Player",
  "description": "Ultra-optimized Gutenberg audio player with seek controls and accessible playback UI.",
  "category": "xpo-blocks",
  "keywords": [
    "audio player",
    "audio",
    "music player",
    "podcast",
    "sound",
    "media player"
  ],
  "textdomain": "xpo-blocks",
  "attributes": {
    "selectedTemplate": {
      "type": "string",
      "default": ""
    },
    "audioUrl": {
      "type": "string",
      "default": ""
    },
    "coverUrl": {
      "type": "string",
      "default": ""
    },
    "labelText": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "subtitle": {
      "type": "string",
      "default": ""
    },
    "playerAlign": {
      "type": "string",
      "default": ""
    },
    "timeDisplayMode": {
      "type": "string",
      "default": ""
    },
    "playerBorder": {
      "type": "object",
      "default": {}
    },
    "playerBorderRadius": {
      "type": "object",
      "default": {}
    },
    "playerBg": {
      "type": "object",
      "default": {}
    },
    "labelColor": {
      "type": "string",
      "default": ""
    },
    "titleColor": {
      "type": "string",
      "default": ""
    },
    "artistColor": {
      "type": "string",
      "default": ""
    },
    "labelTypography": {
      "type": "object",
      "default": {}
    },
    "titleTypography": {
      "type": "object",
      "default": {}
    },
    "artistTypography": {
      "type": "object",
      "default": {}
    },
    "progressColor": {
      "type": "string",
      "default": ""
    },
    "progressBg": {
      "type": "string",
      "default": ""
    },
    "timeColor": {
      "type": "string",
      "default": ""
    },
    "controlColor": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "viewScript": "file:./view.js",
  "style": "file:./style-view.css",
  "render": "file:./render.php"
}