{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "guten-builder-blocks/button",
  "version": "1.0.0",
  "title": "Guten Button",
  "category": "guten-builder",
  "icon": "button",
  "description": "A simple button block.",
  "textdomain": "guten-builder-blocks",
  "attributes": {
    "buttonAlign": {
      "type": "string",
      "default": "center"
    },
    "text": {
      "type": "string",
      "default": "Button"
    },
    "actionType": {
      "type": "string",
      "default": "link"
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "target": {
      "type": "string",
      "default": "_self"
    },
    "padding": {
      "type": "object",
      "default": {
        "top": "10px",
        "right": "20px",
        "bottom": "10px",
        "left": "20px"
      }
    },
    "margin": {
      "type": "object",
      "default": {
        "top": "0px",
        "right": "0px",
        "bottom": "0px",
        "left": "0px"
      }
    },
    "bgColor": {
      "type": "string",
      "default": "#007cba"
    },
    "textColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "iconSource": {
      "type": "string",
      "default": "preset"
    },
    "customIcon1": {
      "type": "string",
      "default": ""
    },
    "customIcon2": {
      "type": "string",
      "default": ""
    },
    "customIcon3": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}