{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "xpo-blocks/newsletter-card",
  "version": "1.0.0",
  "title": "Newsletter Card",
  "category": "xpo-blocks",
  "description": "Add a visually appealing newsletter subscription card to grow your email list and engage with your audience.",
  "textdomain": "xpo-blocks",
  "attributes": {
    "selectedTemplate": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "buttonText": {
      "type": "string",
      "default": ""
    },
    "containerMaxWidth": {
      "type": "string",
      "default": ""
    },
    "containerBg": {
      "type": "object",
      "default": {}
    },
    "containerBorder": {
      "type": "object",
      "default": {}
    },
    "titleColor": {
      "type": "string",
      "default": ""
    },
    "titleTypography": {
      "type": "object",
      "default": {}
    },
    "descriptionColor": {
      "type": "string",
      "default": ""
    },
    "descriptionTypography": {
      "type": "object",
      "default": {}
    },
    "inputColor": {
      "type": "string",
      "default": ""
    },
    "inputBg": {
      "type": "object",
      "default": {}
    },
    "inputBorder": {
      "type": "object",
      "default": {}
    },
    "inputTypography": {
      "type": "object",
      "default": {}
    },
    "buttonColor": {
      "type": "string",
      "default": ""
    },
    "buttonBg": {
      "type": "object",
      "default": {}
    },
    "buttonBorder": {
      "type": "object",
      "default": {}
    },
    "buttonTypography": {
      "type": "object",
      "default": {}
    },
    "successMessage": {
      "type": "string",
      "default": ""
    },
    "errorMessage": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-view.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
