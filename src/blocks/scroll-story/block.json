{
  "apiVersion": 3,
  "name": "xpo-blocks/scroll-story",
  "version": "1.0.0",
  "title": "Scroll Story",
  "description": "Showcase features or timelines with a beautiful scrolling sticky layout.",
  "category": "xpo-blocks",
  "textdomain": "xpo-blocks",
  "keywords": ["scroll", "story", "sticky", "timeline", "features"],
  "attributes": {
    "selectedTemplate": {
      "type": "string",
      "default": ""
    },
    "layout": {
      "type": "string",
      "default": ""
    },
    "steps": {
      "type": "array",
      "default": []
    },
    "progressColor": {
      "type": "string",
      "default": ""
    },
    "activeTitleColor": {
      "type": "string",
      "default": ""
    },
    "inactiveTitleColor": {
      "type": "string",
      "default": ""
    },
    "descColor": {
      "type": "string",
      "default": ""
    },
    "imageFit": {
      "type": "string",
      "default": ""
    },
    "mediaBgColor": {
      "type": "string",
      "default": ""
    },
    "mediaHeight": {
      "type": "string",
      "default": ""
    },
    "mediaRadius": {
      "type": "string",
      "default": ""
    },
    "stepGap": {
      "type": "string",
      "default": ""
    },
    "align": {
      "type": "string",
      "default": "wide"
    }
  },
  "supports": { "html": false, "align": ["wide", "full"] },

  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-view.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
